# Base URL of the Stampede API, including the version segment.
# Default if unset: https://stampede-liard.vercel.app/api/v1
STAMPEDE_API_BASE=https://stampede-liard.vercel.app/api/v1

# Optional API key sent as the X-API-Key header.
# The read endpoints work anonymously, but a key gives you attribution and
# rate limits. Generate one from the Stampede web app (Developer page).
# For read-only usage the key needs the read:stamps and read:profiles scopes.
STAMPEDE_API_KEY=
